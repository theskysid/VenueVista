{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "projects": {"venuevista": {"projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "outputPath": "dist/venuevista"},
        "configurations": {"production": {"optimization": true, "outputHashing": "all", "budgets": [{"type":"initial","maximumWarning":"1mb","maximumError":"2mb"}]}, "development": {"optimization":false,"sourceMap":true}}, "defaultConfiguration":"production"},
      "serve": {"builder":"@angular/build:dev-server","configurations":{"development":{"buildTarget":"venuevista:build:development"}},"defaultConfiguration":"development"}
    }
  }}, "cli":{"analytics":false}
}
